# Povezava do PostgreSQL. Na Railwayu: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kdojekriv

# Ključ za Claude API (https://console.anthropic.com). Samo na strežniku.
ANTHROPIC_API_KEY=

# Dolg naključen niz za zgoščevanje IP naslovov, npr. izhod ukaza: openssl rand -hex 32
IP_SALT=

